{
  "mcpServers": {
    "strata-memory": {
      "command": "uv",
      "args": [
        "run",
        "--directory",
        "/absolute/path/to/strata-memory",
        "strata-memory-mcp"
      ],
      "env": {
        "STRATA_API_KEY": "${STRATA_API_KEY}",
        "STRATA_PALACE": "${STRATA_PALACE:-~/.strata/palace}",
        "STRATA_EMBEDDING_PROVIDER": "siliconflow",
        "STRATA_EMBEDDING_BASE_URL": "https://api.siliconflow.cn/v1",
        "STRATA_EMBEDDING_MODEL": "BAAI/bge-m3"
      }
    }
  }
}
